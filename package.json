{
	"name": "@battlesquid/ts-migrating",
	"version": "1.0.0",
	"description": "Progressively Upgrade `tsconfigs.json`. Original by Jason Yu.",
	"author": "battlesquid",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/battlesquid/ts-migrating.git"
	},
	"homepage": "https://github.com/battlesquid/ts-migrating#readme",
	"bugs": {
		"url": "https://github.com/battlesquid/ts-migrating/issues"
	},
	"keywords": [
		"typescript",
		"migration",
		"cli",
		"plugin"
	],
	"main": "./dist/plugin/mod.js",
	"bin": "./dist/cli/main.js",
	"exports": {
		".": {
			"import": "./dist/plugin/mod.mjs",
			"require": "./dist/plugin/mod.js"
		},
		"./cli": {
			"import": "./dist/cli/main.mjs",
			"require": "./dist/cli/main.js"
		},
		"./api": {
			"import": "./dist/api/mod.mjs",
			"require": "./dist/api/mod.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"biome.config.json"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsup src/cli/main.ts src/api/mod.ts src/plugin/mod.ts",
		"build:watch": "pnpm build --watch",
		"check": "pnpm check:lint && pnpm check:type && pnpm test",
		"check:lint": "biome check .",
		"check:lint:fix": "pnpm check:lint --write",
		"check:type": "tsc",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^25.9.1",
		"ts-migrating": "link:",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.7"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24"
		}
	},
	"dependencies": {
		"@babel/parser": "^7.29.3",
		"@stricli/core": "^1.2.7",
		"recast": "^0.23.11",
		"tinyglobby": "^0.2.16"
	},
	"volta": {
		"node": "26.9.0",
		"pnpm": "12.5.1"
	},
	"packageManager": "pnpm@12.5.1"
}
